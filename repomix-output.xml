<body>
<div class="wrap">
  <div class="mast">
    <h1>Stock Signal</h1>
    <span id="src-label">jo measure hua, wahi dikhta hai</span>
    <button id="src-btn" class="hide">Upstox par jao</button>
  </div>

  <div class="searchbox">
    <input type="text" id="q" placeholder="Company ka naam — Reliance, TCS, Nifty…"
           autocomplete="off" spellcheck="false">
    <div class="results hide" id="results"></div>
  </div>

  <div class="tfs" id="tfs">
    <button data-tf="1m">1 min</button>
    <button data-tf="5m" aria-pressed="true">5 min</button>
    <button data-tf="15m">15 min</button>
    <button data-tf="30m">30 min</button>
    <button data-tf="60m">1 ghanta</button>
    <button data-tf="1d">1 din</button>
  </div>

  <div class="settings">
    <label>Capital (₹)<input type="number" id="capital" min="1000" step="1000" value="100000"></label>
    <label>Risk / trade (%)<input type="number" id="riskpct" min="0.1" max="5" step="0.1" value="1"></label>
    <button class="btn" id="kill-btn">Kill switch: …</button>
  </div>

  <div id="out"><div class="msg">Company ka naam likho — signal yahin aa jayega.</div></div>

  <section class="sugg" id="sugg"></section>

  <p class="foot">
    Forecast card ek logistic-regression model hai jo har baar pichhle data par train hota hai
    aur walk-forward me test hota hai. Jab tak uska out-of-sample record baseline se behtar
    nahi, wo "NO TRADE" hi bolega — chahe probability bar kitna bhi bada dikhe.<br><br>
    Har signal ke saath uska aakhri 40% data ka nateeja dikhta hai — cost aur slippage kaat kar,
    saath me confidence interval. Agar wo number laal hai, us signal par
    paisa mat lagao, chahe direction kitna bhi convincing lage.
  </p>
</div>

<script>
const $ = s => document.querySelector(s);
const q = $('#q'), results = $('#results'), out = $('#out');
// 30-min forecast ke liye 5 min sabse achha base hai: 60 din me ~4500 candle milte hain
let tf = '5m', symbol = null, timer = null, src = 'yahoo', refresh = null;

const money = n => n.toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});
const rupee = n => '₹' + Math.round(n).toLocaleString('en-IN');

// capital / risk — sirf is browser me yaad rakho
const store = {
  get(k, d) { try { return localStorage.getItem(k) ?? d; } catch { return d; } },
  set(k, v) { try { localStorage.setItem(k, v); } catch {} },
};
$('#capital').value = store.get('capital', '100000');
$('#riskpct').value = store.get('riskpct', '1');
const capital = () => Math.max(1000, +$('#capital').value || 100000);
const riskpct = () => Math.min(5, Math.max(0.1, +$('#riskpct').value || 1));
['capital','riskpct'].forEach(id => $('#' + id).addEventListener('change', e => {
  store.set(id, e.target.value);
  if (symbol) run();
}));

async function killState(toggle) {
  try {
    let on;
    if (toggle) {
      const cur = $('#kill-btn').dataset.on === '1';
      on = (await (await fetch('/api/kill?on=' + !cur, {method:'POST'})).json()).kill_switch;
    } else {
      on = (await (await fetch('/api/risk?capital=' + capital())).json()).kill_switch;
    }
    $('#kill-btn').dataset.on = on ? '1' : '0';
    $('#kill-btn').textContent = 'Kill switch: ' + (on ? 'ON' : 'OFF');
    $('#kill-btn').classList.toggle('danger', on);
    if (toggle && symbol) run(true);
  } catch {}
}
$('#kill-btn').addEventListener('click', () => killState(true));
killState(false);

fetch('/api/sources').then(r=>r.json()).then(s=>{
  if (s.upstox) $('#src-btn').classList.remove('hide');
}).catch(()=>{});

$('#src-btn').addEventListener('click', () => {
  src = src === 'yahoo' ? 'upstox' : 'yahoo';
  $('#src-btn').textContent = src === 'yahoo' ? 'Upstox par jao' : 'Yahoo par jao';
  symbol = null; q.value = ''; clearTimeout(refresh);
  out.innerHTML = '<div class="msg">Company ka naam likho — ab ' + src + ' se data aayega.</div>';
});

q.addEventListener('input', () => {
  clearTimeout(timer);
  const v = q.value.trim();
  if (v.length < 2) { results.classList.add('hide'); return; }
  timer = setTimeout(async () => {
    try {
      const r = await fetch('/api/search?q=' + encodeURIComponent(v) + '&source=' + src);
      const { results: list } = await r.json();
      if (!list.length) { results.classList.add('hide'); return; }
      results.innerHTML = list.map(s =>
        `<button data-sym="${s.symbol}" data-label="${s.name.replace(/"/g,'&quot;')}">
           ${s.name}<small>${s.symbol} · ${s.exchange}</small></button>`).join('');
      results.classList.remove('hide');
    } catch { results.classList.add('hide'); }
  }, 280);
});

results.addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  symbol = b.dataset.sym; q.value = b.dataset.label;
  results.classList.add('hide'); run();
});
document.addEventListener('click', e => {
  if (!e.target.closest('.searchbox')) results.classList.add('hide');
});

$('#tfs').addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  tf = b.dataset.tf;
  [...$('#tfs').children].forEach(x => x.setAttribute('aria-pressed', x === b));
  clearTimeout(refresh);
  if (symbol) run();
});

async function run(quiet) {
  clearTimeout(refresh);
  const want = `${symbol}|${tf}|${src}`;
  if (!quiet) out.innerHTML = '<div class="msg">Candles la raha hoon, model train kar raha hoon, walk-forward test chala raha hoon…</div>';
  try {
    const r = await fetch(`/api/analyze?symbol=${encodeURIComponent(symbol)}&interval=${tf}&source=${src}` +
                          `&capital=${capital()}&risk_pct=${riskpct()}`);
    const d = await r.json();
    if (want !== `${symbol}|${tf}|${src}`) return;   // beech me user ne kuch aur chun liya
    if (!r.ok) { if (!quiet) out.innerHTML = `<div class="msg err">${d.detail || 'Data nahi mila'}</div>`; return; }
    render(d);
    // market khula ho to har minute naya candle check karo
    if (d.market_open) refresh = setTimeout(() => run(true), 60000);
  } catch {
    if (!quiet) out.innerHTML = '<div class="msg err">Server tak nahi pahuncha. Dobara koshish karo.</div>';
  }
}

const pct = x => (x > 0 ? '+' : '') + x;

function evBlock(f) {
  const e = f.ev || {};
  if (f.predicted === 'FLAT') return `<p>Model ko cost se bada move nahi dikhta — trade ka EV nikalne ki zaroorat nahi.</p>`;
  if (e.avg_pct == null) return `<p>Pehle model ne aisi call sirf ${e.n || 0} baar ki — EV napne ke liye kam se kam 10 non-overlapping trade chahiye.</p>`;
  const col = e.ci_low_pct > 0 ? 'var(--up)' : e.avg_pct > 0 ? 'var(--flat)' : 'var(--down)';
  return `<div class="row3">
      <div><span style="color:${col}">${pct(e.avg_pct)}%</span><small>EV per trade</small></div>
      <div><span>${e.ci_low_pct}…${e.ci_high_pct}%</span><small>90% CI</small></div>
      <div><span>${e.n}</span><small>purane trade</small></div>
    </div>
    <p style="font-size:11.5px;margin-top:6px">EV = ${e.ev_formula} (jeet % × avg jeet − haar % × avg haar,
      cost pehle hi kata). Win rate ${e.win_pct}%. Aadhar: ${e.basis}. EV ka neecha sira zero se upar ho tabhi LONG/SHORT.</p>`;
}

function riskLine(r) {
  if (!r) return '';
  const col = r.blocked ? 'var(--down)' : 'var(--dim)';
  return `<p style="font-size:11.5px;margin-top:6px;color:${col}">Aaj: ${r.trades_today}/${r.limits.max_trades_per_day} signal ·
    P&L ${rupee(r.day_pnl)} (limit −${r.limits.max_daily_loss_pct}%) · lagatar haar ${r.consec_losses}/${r.limits.max_consec_losses}
    ${r.blocked ? '<br>⛔ ' + r.reasons.join(' · ') : ''}</p>`;
}
const CCOL = {UP:'var(--up)', DOWN:'var(--down)', FLAT:'var(--flat)'};
const SIGCOL = {LONG:'var(--up)', SHORT:'var(--down)', WATCH:'var(--flat)', 'NO TRADE':'var(--muted)'};
const CONFCOL = {HIGH:'var(--up)', MEDIUM:'var(--flat)', LOW:'var(--down)'};

function forecastCard(f, t, cur, d) {
  if (!f || !f.available) return `<div class="card fc"><h3>30 min forecast</h3>
    <p>${(f && f.reason) || 'Forecast nahi bana.'}</p></div>`;
  const q = f.quality, c = f.calibrated, tr = q.trades;
  const bars = ['UP','FLAT','DOWN'].map(k => `<div class="bar"><span>${k}</span>
    <i><b style="width:${f.probs[k]}%;background:${CCOL[k]}"></b></i><span>${f.probs[k]}%</span></div>`).join('');
  const li = (arr, mark) => arr.map(x => `<li>${mark} ${x.name} <code>${pct(x.value)}</code></li>`).join('');
  const reg = [f.regime.trend, f.regime.volatility, f.regime.event].filter(Boolean)
    .map(x => `<span>${x}</span>`).join('');
  const cal = q.calibration.map(b => `<tr><td class="n">${b.range}</td>
    <td class="r">model ne kaha ${b.said_pct}% · asli ${b.actual_pct}%</td><td class="v">${b.n}</td></tr>`).join('');
  const track = t && t.logged ? `<div class="sub">Live record (is tool ki apni logged predictions)</div>
    <p>${t.logged} predictions log hui, ${t.resolved} ka nateeja aa chuka${t.resolved ? ` — ${t.hit_pct}% sahi` : ''}.
    ${t.signals ? `LONG/SHORT signal ${t.signals} baar, average ${pct(t.signal_avg_pct)}% cost ke baad.` : ''}
    Backtest se zyada bharosa is number par karo, jab ye 100+ ho jaye.</p>` : '';

  return `<div class="card fc">
    <h3>${f.horizon_label} ka forecast
      <span class="tag" style="color:${CONFCOL[f.confidence]}">confidence ${f.confidence}</span></h3>
    <div class="bars">${bars}</div>
    <p style="font-size:11.5px">UP/DOWN = ${f.band_pct}% (cost + slippage) se bada move. Ye model ki
      kacchi probability hai — neeche wala number zyada zaroori hai.</p>

    <div class="sub">Pehle jab model ne aisa kaha tha</div>
    <p style="color:var(--text)">${c.n} baar model ne <b style="color:${CCOL[f.predicted]}">${f.predicted}</b>
      kaha (${c.basis}) — asli me <b>${c.hit_pct}%</b> baar sahi nikla
      (90% CI ${c.low_pct}–${c.high_pct}%). Bina kisi model ke bhi ${f.predicted}
      ${c.base_rate_pct}% baar hota hai.</p>

    <div class="sub">Expected value — asli faisla isi se</div>
    ${evBlock(f)}

    <div class="sub">Signal</div>
    <div class="sig" style="color:${SIGCOL[f.signal]}">${f.signal}</div>
    <p>${f.signal_reason}</p>
    ${riskLine(d.risk)}

    <div class="sub">Position size (capital ${rupee(d.sizing.capital)}, risk ${d.sizing.risk_pct}%)</div>
    <p style="color:var(--text)"><b>${d.sizing.qty} shares</b> · order ${rupee(d.sizing.order_value)} ·
      stop lage to max nuksaan ~${rupee(d.sizing.max_loss)} (cost milakar)
      ${d.sizing.capped ? '<br><span style="color:var(--dim)">Capital ki limit lagi — bina leverage itne hi shares aate hain.</span>' : ''}</p>
