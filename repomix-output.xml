<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Stock Signal — jo measure hua, wahi dikhta hai</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0D151E; --surface:#16222F; --raised:#1D2C3B;
    --line:#26384A; --text:#E3EEF6; --muted:#7D94A8; --dim:#5A7186;
    --up:#31C48D; --down:#F87171; --flat:#E3A84A;
    --sans:"IBM Plex Sans",system-ui,-apple-system,sans-serif;
    --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--text);font-family:var(--sans);
    font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased;padding:20px 16px 56px}
  .wrap{max-width:560px;margin:0 auto}

  .mast{display:flex;align-items:baseline;gap:10px;margin-bottom:22px}
  .mast h1{font-size:17px;font-weight:600;letter-spacing:-.01em}
  .mast span{font-size:12.5px;color:var(--dim)}
  .mast button{margin-left:auto;padding:5px 11px;background:none;border:1px solid var(--line);
    border-radius:16px;color:var(--muted);font-family:var(--sans);font-size:12px;cursor:pointer}
  .mast button:hover{color:var(--text);border-color:var(--muted)}

  .searchbox{position:relative}
  input[type=text]{width:100%;padding:13px 15px;background:var(--surface);color:var(--text);
    border:1px solid var(--line);border-radius:9px;font-family:var(--sans);font-size:15px}
  input[type=text]::placeholder{color:var(--dim)}
  input[type=text]:focus{outline:2px solid var(--up);outline-offset:1px;border-color:transparent}
  .results{position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:20;background:var(--raised);
    border:1px solid var(--line);border-radius:9px;overflow:hidden;box-shadow:0 12px 32px rgba(0,0,0,.45)}
  .results button{display:block;width:100%;text-align:left;padding:11px 14px;background:none;border:0;
    border-bottom:1px solid var(--line);color:var(--text);font-family:var(--sans);font-size:14px;cursor:pointer}
  .results button:last-child{border-bottom:0}
  .results button:hover,.results button:focus{background:var(--surface);outline:none}
  .results small{display:block;color:var(--muted);font-size:12px;margin-top:1px}

  .tfs{display:flex;gap:6px;margin:12px 0 22px;flex-wrap:wrap}
  .tfs button{padding:7px 13px;background:var(--surface);border:1px solid var(--line);border-radius:20px;
    color:var(--muted);font-family:var(--mono);font-size:13px;cursor:pointer}
  .tfs button[aria-pressed=true]{background:var(--text);color:var(--bg);border-color:var(--text);font-weight:500}

  .banner{background:var(--raised);border-left:3px solid var(--flat);padding:10px 13px;border-radius:0 8px 8px 0;
    font-size:12.5px;color:var(--muted);margin-bottom:18px;line-height:1.45}

  .head{margin-bottom:14px}
  .head h2{font-size:19px;font-weight:600;letter-spacing:-.015em;line-height:1.25}
  .head p{font-size:12.5px;color:var(--dim);margin-top:3px;font-family:var(--mono)}
  .price{display:flex;align-items:baseline;gap:11px;margin-bottom:10px;flex-wrap:wrap}
  .price b{font-family:var(--mono);font-size:33px;font-weight:500;letter-spacing:-.02em}
  .price em{font-family:var(--mono);font-size:14px;font-style:normal}
  .spark{width:100%;height:46px;display:block;margin-bottom:22px;overflow:visible}

  .verdict{border-left:3px solid var(--c);padding:2px 0 2px 14px;margin-bottom:20px}
  .verdict strong{display:block;font-size:22px;font-weight:600;color:var(--c);letter-spacing:-.015em}
  .verdict p{font-size:13px;color:var(--muted);margin-top:4px}

  .card{background:var(--surface);border-radius:11px;padding:16px;margin-bottom:12px}
  .card h3{font-size:13px;font-weight:600;margin-bottom:11px}
  .card p{font-size:12.5px;color:var(--muted)}
  .card.warn{border-left:3px solid var(--down)}

  .plan{display:flex;gap:0;text-align:center}
  .plan div{flex:1;padding:0 4px}
  .plan span{display:block;font-family:var(--mono);font-size:17px;font-weight:500}
  .plan small{display:block;font-size:11px;color:var(--dim);margin-top:2px}

  .stats{display:grid;grid-template-columns:1fr 1fr;gap:13px 18px}
  .stats div span{display:block;font-family:var(--mono);font-size:19px;font-weight:500}
  .stats div small{display:block;font-size:11px;color:var(--dim);margin-top:1px}
  .insample{opacity:.45;font-size:11.5px;font-family:var(--mono);color:var(--muted);
    margin-top:13px;padding-top:11px;border-top:1px solid var(--line)}

  table{width:100%;border-collapse:collapse}
  caption{text-align:left;font-size:13px;font-weight:600;padding:15px 0 9px}
  td{padding:9px 0;border-top:1px solid var(--line);vertical-align:top;font-size:13.5px}
  tr:first-child td{border-top:0}
  td.n{width:36%;color:var(--text)}
  td.r{color:var(--muted);font-family:var(--mono);font-size:12.5px}
  td.v{width:46px;text-align:right;font-family:var(--mono);font-size:12.5px;font-weight:500}

  .foot{font-size:12px;color:var(--dim);line-height:1.6;margin-top:22px}
  .msg{background:var(--surface);border-radius:11px;padding:22px 18px;text-align:center;
    color:var(--muted);font-size:14px}
  .err{color:var(--down)}
  .hide{display:none}

  .fc h3{display:flex;align-items:center;gap:8px}
  .tag{margin-left:auto;font-family:var(--mono);font-size:11px;padding:2px 8px;border-radius:10px;
    border:1px solid currentColor}
  .bars{margin:4px 0 14px}
  .bar{display:grid;grid-template-columns:52px 1fr 48px;align-items:center;gap:8px;margin:5px 0;
    font-family:var(--mono);font-size:12.5px}
  .bar i{display:block;height:8px;border-radius:4px;background:var(--line)}
  .bar i b{display:block;height:100%;border-radius:4px}
  .bar span:last-child{text-align:right}
  .sig{font-size:20px;font-weight:600;letter-spacing:-.01em}
  .fc ul{list-style:none;margin:6px 0 0;font-size:12.5px;color:var(--muted)}
  .fc li{padding:2px 0}
  .fc li code{font-family:var(--mono);color:var(--dim);font-size:11.5px}
  .sub{font-size:11.5px;color:var(--dim);text-transform:uppercase;letter-spacing:.06em;margin:14px 0 2px}
  .chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
  .chips span{font-family:var(--mono);font-size:11px;padding:3px 8px;border-radius:10px;
    background:var(--raised);color:var(--muted)}
  .row3{display:flex;gap:0;text-align:center;margin-top:8px}
  .row3 div{flex:1;padding:0 4px}
  .row3 span{display:block;font-family:var(--mono);font-size:15px;font-weight:500}
  .row3 small{display:block;font-size:11px;color:var(--dim);margin-top:2px}
  details{margin-top:14px;border-top:1px solid var(--line);padding-top:10px}
  summary{cursor:pointer;font-size:12.5px;color:var(--muted)}
  details table td{font-size:12px;padding:6px 0}

  .settings{display:flex;gap:10px;margin:-10px 0 22px;flex-wrap:wrap;align-items:end}
  .settings label{font-size:11px;color:var(--dim);display:flex;flex-direction:column;gap:3px}
  .settings input{width:120px;padding:7px 10px;background:var(--surface);color:var(--text);
    border:1px solid var(--line);border-radius:8px;font-family:var(--mono);font-size:13px}
  .btn{padding:7px 12px;background:none;border:1px solid var(--line);border-radius:8px;
    color:var(--muted);font-family:var(--sans);font-size:12px;cursor:pointer}
  .btn:hover{color:var(--text);border-color:var(--muted)}
  .btn.danger{border-color:var(--down);color:var(--down)}

  .sugg{margin-top:34px}
  .sugg h2{font-size:16px;font-weight:600;margin-bottom:4px}
  .sugg .lead{font-size:12.5px;color:var(--muted);margin-bottom:12px}
  .srow{display:grid;grid-template-columns:1fr auto auto;gap:4px 12px;width:100%;text-align:left;
    padding:11px 13px;margin-bottom:6px;background:var(--surface);border:1px solid var(--line);
    border-radius:9px;color:var(--text);font-family:var(--sans);cursor:pointer;align-items:center}
  .srow:hover{border-color:var(--muted)}
  .srow.q{border-left:3px solid var(--up)}
  .srow b{font-size:13.5px;font-weight:600}
  .srow small{grid-column:1/-1;font-size:11.5px;color:var(--dim);font-family:var(--mono)}
  .srow .d{font-family:var(--mono);font-size:12.5px}
  .srow .e{font-family:var(--mono);font-size:12.5px;text-align:right;min-width:78px}
  .prog{height:4px;background:var(--line);border-radius:2px;overflow:hidden;margin:8px 0 12px}
  .prog b{display:block;height:100%;background:var(--up)}
</style>
